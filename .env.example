# Application
GO_UPTIME_ENVIRONMENT=development
GO_UPTIME_HTTP_PORT=8080
GO_UPTIME_SESSION_SECRET=change-me-in-production
# Set true behind HTTPS. Outside development, Secure defaults to true if this is unset.
GO_UPTIME_SESSION_SECURE=false
GO_UPTIME_INCIDENT_RETENTION_DAYS=90
GO_UPTIME_MAX_RESOLVED_INCIDENTS_PER_MONITOR=100
GO_UPTIME_CHECK_CONCURRENCY=150

# Database
GO_UPTIME_DATABASE_HOST=localhost
GO_UPTIME_DATABASE_PORT=5432
GO_UPTIME_DATABASE_USER=gouptime
GO_UPTIME_DATABASE_PASSWORD=change-me
GO_UPTIME_DATABASE_NAME=gouptime
GO_UPTIME_DATABASE_SSLMODE=disable

# Logging
GIN_MODE=debug
LOG_LEVEL=info

# Test API (disabled by default; only allowed when GO_UPTIME_ENVIRONMENT=development)
GO_UPTIME_ENABLE_PLAYWRIGHT_API=false

# Test database name (for go test and Playwright)
GO_UPTIME_TEST_DATABASE_NAME=go-uptime-test
